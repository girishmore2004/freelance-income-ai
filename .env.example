
# Transactional email provider: smtp or resend
EMAIL_PROVIDER=smtp

# Resend HTTP email provider
# Use EMAIL_PROVIDER=resend to activate it.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=Freelance Income AI
RESEND_API_BASE_URL=https://api.resend.com

# SMTP fallback/provider
# Use EMAIL_PROVIDER=smtp to activate it.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Freelance Income AI
SMTP_USE_SSL=false

# Email verification and password recovery
REQUIRE_EMAIL_VERIFICATION=false
PUBLIC_APP_URL=http://localhost:3000
