APP_NAME=Freelance Income AI
ENVIRONMENT=development
SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
ACCESS_TOKEN_EXPIRE_MINUTES=720
DATABASE_URL=postgresql+psycopg://freelance:freelance_dev_password@db:5432/freelance_ai
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:3b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
RSS_ALLOWED_DOMAINS=
MAX_RSS_ITEMS_PER_FEED=30

# Release 0.2 integrations
N8N_WEBHOOK_SECRET=replace-with-a-long-random-secret
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
UPLOAD_MAX_MB=10
PUBLIC_REGISTRATION=true
# Optional: enables protected /api/v1/system/diagnostics; send as X-Diagnostics-Key.
DIAGNOSTICS_API_KEY=
# Account verification and password reset email (SMTP). Required in production when verification is enabled.
REQUIRE_EMAIL_VERIFICATION=false
# Authentication hardening: lock account after repeated failures; MFA challenge is single-use.
LOGIN_FAILURE_LIMIT=8
LOGIN_LOCKOUT_MINUTES=15
MFA_CHALLENGE_MINUTES=5
MFA_CHALLENGE_MAX_ATTEMPTS=5
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Freelance Income AI
SMTP_USE_SSL=false
PUBLIC_APP_URL=http://localhost:3000

# Release 0.3: background queue and hybrid retrieval
REDIS_URL=redis://redis:6379/0
# Set lexical for cloud deployments without a reachable embedding model or embedding API.
# EMBEDDING_PROVIDER=lexical
EMBEDDING_PROVIDER=ollama
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
RETRIEVAL_TOP_K=6
RETRIEVAL_MIN_SCORE=0.12

# Retrieval mode: auto (pgvector on PostgreSQL, lexical fallback otherwise)
RETRIEVAL_BACKEND=auto
RETRIEVAL_CANDIDATE_LIMIT=1000

# Shared Fernet key for Gmail/Microsoft OAuth and future marketplace credential vault.
# Preserve this exact key across deployments; changing it makes existing encrypted tokens unreadable.
# Release 1.4 email OAuth; v5.5 marketplace vault storage foundation.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OAUTH_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/email-integrations/callback/google
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:8000/api/v1/email-integrations/callback/microsoft

# Release 3.3: shared Redis-backed API rate limits (per actor and route class)
RATE_LIMIT_API_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_AI_PER_MINUTE=30

# Per-account AI operation quotas (proposal generation currently metered)
AI_QUOTA_DAILY_CALLS=20
AI_QUOTA_MONTHLY_CALLS=300

# Cloud deployment:
# Do not use localhost for OLLAMA_BASE_URL in production.
# Frontend Vercel build requires NEXT_PUBLIC_API_URL=https://YOUR-API-HOST.
# API and worker must share DATABASE_URL and REDIS_URL.

# Upwork OAuth 2.0 (requires provider API approval and registered callback)
UPWORK_CLIENT_ID=
UPWORK_CLIENT_SECRET=
UPWORK_REDIRECT_URI=https://YOUR_API_HOST/api/v1/marketplaces/upwork/oauth/callback
# Set only scopes explicitly approved for your Upwork API key; no default scopes are assumed.
UPWORK_SCOPES=

# Enable only after the hourly cleanup workflow is configured and verified.
UPWORK_CACHE_RETENTION_ENABLED=false

# v5.8.0: keep false until both hourly listing retention and scheduled discovery jobs are deployed and tested
