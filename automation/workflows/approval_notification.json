{
  "name": "Freelance Income AI - Approval Webhook",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "fia-approval-notification",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "webhook",
      "name": "Approval Event Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "chatId": "={{$env.TELEGRAM_CHAT_ID}}",
        "text": "=Approval required: {{$json.body.title || 'New proposal'}}. Open your dashboard to review.",
        "additionalFields": {}
      },
      "id": "telegram",
      "name": "Telegram Notification",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        500,
        300
      ]
    }
  ],
  "connections": {
    "Approval Event Webhook": {
      "main": [
        [
          {
            "node": "Telegram Notification",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}