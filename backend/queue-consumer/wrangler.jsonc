
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "freelance-income-ai-consumer",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-13",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "queues": {
    "consumers": [
      {
        "queue": "freelance-income-ai-jobs",
        "max_batch_size": 5,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "retry_delay": 30,
        "dead_letter_queue": "freelance-income-ai-jobs-dlq"
      }
    ]
  }
}
