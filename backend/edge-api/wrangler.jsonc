
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "freelance-income-ai-api-edge",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-14",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "vars": {
    "APP_NAME": "Freelance Income AI",
    "APP_VERSION": "5.76.0",
    "APP_ENV": "staging",
    "CORS_ORIGINS": "https://freelance-income-ai.girishmore097.workers.dev",
    "PUBLIC_REGISTRATION": "false",
    "REQUIRE_EMAIL_VERIFICATION": "false",
    "ACCESS_TOKEN_EXPIRE_MINUTES": "720"
  },
  "triggers": {
    "crons": [
      "0 */6 * * *"
    ]
  },
  "ai": {
    "binding": "AI"
  },
  // Approximate, per-location throttling (needs Wrangler >= 4.36). namespace_id
  // values must be unique positive integers within the Cloudflare account.
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 }
    },
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 300, "period": 60 }
    }
  ],
  // Contract files (lib/file-routes.ts). Create the bucket FIRST in Cloudflare
  // (R2 -> Create bucket -> "freelance-income-ai-files"), then uncomment this
  // block. A binding to a bucket that does not exist makes the deploy fail.
  // Until then file uploads answer 503 FILES_NOT_CONFIGURED and links still work.
  // "r2_buckets": [
  //   { "binding": "FILES", "bucket_name": "freelance-income-ai-files" }
  // ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "1875e95a677743fd839e89bc7836e9e7"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "FREELANCE_JOBS",
        "queue": "freelance-income-ai-jobs"
      }
    ],
    // This Worker is the consumer. Remove the consumer from the old
    // "freelance-income-ai-consumer" Worker BEFORE deploying (a queue can
    // have only one consumer). Retry/DLQ settings match the old consumer.
    "consumers": [
      {
        "queue": "freelance-income-ai-jobs",
        "max_batch_size": 5,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "retry_delay": 30,
        "dead_letter_queue": "freelance-income-ai-jobs-dlq"
      }
    ]
  }
}
