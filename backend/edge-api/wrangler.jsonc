
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "freelance-income-ai-api-edge",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-14",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "vars": {
    "APP_NAME": "Freelance Income AI",
    "APP_VERSION": "5.45.1",
    "APP_ENV": "staging",
    "CORS_ORIGINS": "https://freelance-income-ai.girishmore097.workers.dev",
    "PUBLIC_REGISTRATION": "false",
    "REQUIRE_EMAIL_VERIFICATION": "false"
  },
  "ai": {
    "binding": "AI"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "1875e95a677743fd839e89bc7836e9e7"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "FREELANCE_JOBS",
        "queue": "freelance-income-ai-jobs"
      }
    ]
  }
}
